# =============================================================
# RezeBot — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ─── Core ────────────────────────────────────────────────
BOT_TOKEN=123456789:AAFdjkflsdjfklsdjflksdjflksdjflksd
NODE_ENV=development
PORT=3000
WEB_PORT=3001
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://rezebot:changeme@localhost:5432/rezebot?schema=public
PGHOST=localhost
PGPORT=5432
PGDATABASE=rezebot
PGUSER=rezebot
PGPASSWORD=changeme
PGSSL=false

# ─── Redis (Optional) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Web Panel ───────────────────────────────────────────
SESSION_SECRET=super_secret_key_change_this_in_production
WEBAPP_URL=https://your-domain.com
WEB_TOKEN_SECRET=another_very_secret_key_for_jwt

# ─── AI Provider (Optional — for AI Mode) ────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7

# ─── Crypto Provider (Optional — for Crypto Module) ──────
CRYPTO_PROVIDER=coingecko
CRYPTO_API_KEY=your_api_key_here

# ─── Currency Provider ───────────────────────────────────
CURRENCY_PROVIDER=exchangerate-api
CURRENCY_API_KEY=your_api_key_here

# ─── Gifts Provider ──────────────────────────────────────
GIFTS_PROVIDER=telegram
GIFTS_API_KEY=

# ─── Speech Provider (Optional) ─────────────────────────
SPEECH_PROVIDER=
SPEECH_API_KEY=

# ─── Rate Limiting ───────────────────────────────────────
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_COMMAND=10
RATE_LIMIT_CHAT=30
RATE_LIMIT_IP=100

# ─── Deployment ─────────────────────────────────────────
DOMAIN=rezebot.example.com
WEBHOOK_SECRET=webhook_secret_here
HEROKU_APP=
RENDER_SERVICE=

# ─── Owner (Super Admin) ─────────────────────────────────
OWNER_ID=123456789

# ─── Feature Flags ───────────────────────────────────────
ENABLE_AI=false
ENABLE_CRYPTO=false
ENABLE_GIFTS=false
ENABLE_GAMES=true
ENABLE_MUSIC=false
ENABLE_PAYMENTS=false
ENABLE_MINI_APP=true
ENABLE_TOPICS=true
ENABLE_REACTIONS=true
